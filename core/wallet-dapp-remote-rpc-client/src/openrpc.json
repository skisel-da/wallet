{
    "openrpc": "1.2.6",
    "info": {
        "title": "Wallet JSON-RPC Remote dApp API",
        "version": "0.1.0",
        "description": "An OpenRPC specification for remotely hosted Wallet Providers. Due to the remote nature, an implementing provider must bridge certain functionality on the client-side to satisfy the general dApp API spec."
    },
    "methods": [
        {
            "name": "status",
            "params": [],
            "result": {
                "name": "result",
                "schema": {
                    "$ref": "api-specs/openrpc-dapp-api.json#/components/schemas/StatusEvent"
                }
            },
            "description": "Returns the current status of the wallet provider session."
        },
        {
            "name": "connect",
            "params": [],
            "result": {
                "name": "result",
                "schema": {
                    "$ref": "api-specs/openrpc-dapp-api.json#/components/schemas/ConnectResult"
                }
            },
            "description": "Ensures ledger connectivity and returns the connected network information."
        },
        {
            "name": "disconnect",
            "params": [],
            "result": {
                "name": "result",
                "schema": {
                    "$ref": "api-specs/openrpc-dapp-api.json#/components/schemas/Null"
                }
            },
            "description": "Invoke a disconnect of the wallet gateway session."
        },
        {
            "name": "isConnected",
            "params": [],
            "result": {
                "name": "result",
                "schema": {
                    "$ref": "api-specs/openrpc-dapp-api.json#/components/schemas/ConnectResult"
                }
            },
            "description": "Returns the connection status and the connected network information."
        },
        {
            "name": "getActiveNetwork",
            "params": [],
            "result": {
                "name": "result",
                "schema": {
                    "$ref": "api-specs/openrpc-dapp-api.json#/components/schemas/Network"
                }
            },
            "description": "Returns the active network."
        },
        {
            "name": "prepareExecute",
            "params": [
                {
                    "name": "params",
                    "schema": {
                        "title": "prepareExecuteParams",
                        "$ref": "api-specs/openrpc-dapp-api.json#/components/schemas/JsPrepareSubmissionRequest"
                    }
                }
            ],
            "result": {
                "name": "result",
                "schema": {
                    "title": "prepareExecuteResult",
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "userUrl": {
                            "$ref": "api-specs/openrpc-dapp-api.json#/components/schemas/UserUrl"
                        },
                        "userUrlKind": {
                            "title": "userUrlKind",
                            "type": "string",
                            "enum": ["approval", "handoff"],
                            "description": "What the page at userUrl is, so a client can present it appropriately. 'approval' is this wallet's own short-lived approve/sign page for the calling user. 'handoff' is a different application, where other people take part and the user may stay for a while -- multi-owner coordination for a party whose signing is delegated. A browser client should give a handoff a normal tab rather than a small transient popup; a CLI or mobile client can act on the distinction too, which is why this says what the page IS rather than which window to use. Absent means 'approval'."
                        }
                    },
                    "required": ["userUrl"]
                }
            },
            "description": "Prepares, signs, and executes a transaction."
        },
        {
            "name": "signMessage",
            "params": [
                {
                    "name": "params",
                    "required": true,
                    "schema": {
                        "title": "signMessageParams",
                        "$ref": "api-specs/openrpc-dapp-api.json#/components/schemas/SignMessageRequest"
                    }
                }
            ],
            "result": {
                "name": "result",
                "schema": {
                    "title": "signMessageResult",
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "messageId": {
                            "$ref": "api-specs/openrpc-dapp-api.json#/components/schemas/MessageId"
                        },
                        "userUrl": {
                            "$ref": "api-specs/openrpc-dapp-api.json#/components/schemas/UserUrl"
                        }
                    },
                    "required": ["messageId", "userUrl"]
                }
            },
            "description": "Requests a message signature. The wallet will prompt the user for confirmation."
        },
        {
            "name": "signTopologyTransactions",
            "params": [
                {
                    "name": "params",
                    "required": true,
                    "schema": {
                        "title": "signTopologyTransactionsParams",
                        "$ref": "api-specs/openrpc-dapp-api.json#/components/schemas/SignTopologyTransactionsRequest"
                    }
                }
            ],
            "result": {
                "name": "result",
                "schema": {
                    "title": "signTopologyTransactionsResult",
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "requestId": {
                            "$ref": "api-specs/openrpc-dapp-api.json#/components/schemas/TopologyRequestId"
                        },
                        "userUrl": {
                            "$ref": "api-specs/openrpc-dapp-api.json#/components/schemas/UserUrl"
                        }
                    },
                    "required": ["requestId", "userUrl"]
                }
            },
            "description": "Requests a topology-transactions bundle signature. The wallet will prompt the user for confirmation."
        },
        {
            "name": "signPreparedTransaction",
            "params": [
                {
                    "name": "params",
                    "required": true,
                    "schema": {
                        "title": "signPreparedTransactionParams",
                        "$ref": "api-specs/openrpc-dapp-api.json#/components/schemas/SignPreparedTransactionRequest"
                    }
                }
            ],
            "result": {
                "name": "result",
                "schema": {
                    "title": "signPreparedTransactionResult",
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "requestId": {
                            "$ref": "api-specs/openrpc-dapp-api.json#/components/schemas/PreparedTransactionRequestId"
                        },
                        "userUrl": {
                            "$ref": "api-specs/openrpc-dapp-api.json#/components/schemas/UserUrl"
                        }
                    },
                    "required": ["requestId", "userUrl"]
                }
            },
            "description": "Requests a signature over an already-prepared ordinary ledger transaction. The wallet will prompt the user for confirmation."
        },
        {
            "name": "submitDelegatedSignatures",
            "params": [
                {
                    "name": "params",
                    "schema": {
                        "$ref": "api-specs/openrpc-dapp-api.json#/components/schemas/SubmitDelegatedSignaturesRequest"
                    }
                }
            ],
            "result": {
                "name": "result",
                "schema": {
                    "$ref": "api-specs/openrpc-dapp-api.json#/components/schemas/SubmitDelegatedSignaturesResult"
                }
            },
            "description": "Hands the Wallet Gateway the signature set an external coordinator collected for a delegated signing request (a party whose signingProviderId is 'decentralized'). The gateway verifies them against the hash the request was created for, then submits the transaction once. Any connected owner may call this -- coordination is inherently multi-party, and the signatures themselves are the authorization."
        },
        {
            "name": "ledgerApi",
            "params": [
                {
                    "name": "params",
                    "schema": {
                        "title": "ledgerApiParams",
                        "$ref": "api-specs/openrpc-dapp-api.json#/components/schemas/LedgerApiRequest"
                    }
                }
            ],
            "result": {
                "name": "result",
                "schema": {
                    "$ref": "api-specs/openrpc-dapp-api.json#/components/schemas/LedgerApiResult"
                }
            },
            "description": "Proxy for the JSON-API endpoints. Injects authorization headers automatically."
        },
        {
            "name": "connected",
            "params": [],
            "result": {
                "name": "result",
                "schema": {
                    "$ref": "api-specs/openrpc-dapp-api.json#/components/schemas/StatusEvent"
                }
            },
            "description": "Informs when the user connects to a network."
        },
        {
            "name": "onStatusChanged",
            "params": [],
            "result": {
                "name": "result",
                "schema": {
                    "$ref": "api-specs/openrpc-dapp-api.json#/components/schemas/StatusEvent"
                }
            }
        },
        {
            "name": "accountsChanged",
            "params": [],
            "result": {
                "name": "result",
                "schema": {
                    "$ref": "api-specs/openrpc-dapp-api.json#/components/schemas/AccountsChangedEvent"
                }
            }
        },
        {
            "name": "getPrimaryAccount",
            "params": [],
            "result": {
                "name": "result",
                "schema": {
                    "$ref": "api-specs/openrpc-user-api.json#/components/schemas/Wallet"
                }
            },
            "description": "Returns the primary account."
        },
        {
            "name": "listAccounts",
            "params": [],
            "result": {
                "name": "result",
                "schema": {
                    "$ref": "api-specs/openrpc-dapp-api.json#/components/schemas/ListAccountsResult"
                }
            }
        },
        {
            "name": "txChanged",
            "params": [],
            "result": {
                "name": "result",
                "schema": {
                    "$ref": "api-specs/openrpc-dapp-api.json#/components/schemas/TxChangedEvent"
                }
            }
        },
        {
            "name": "messageSignature",
            "params": [],
            "result": {
                "name": "result",
                "schema": {
                    "$ref": "api-specs/openrpc-dapp-api.json#/components/schemas/MessageSignatureEvent"
                }
            }
        },
        {
            "name": "topologyTransactionsSignature",
            "params": [],
            "result": {
                "name": "result",
                "schema": {
                    "$ref": "api-specs/openrpc-dapp-api.json#/components/schemas/TopologyTransactionsSignatureEvent"
                }
            }
        },
        {
            "name": "preparedTransactionSignature",
            "params": [],
            "result": {
                "name": "result",
                "schema": {
                    "$ref": "api-specs/openrpc-dapp-api.json#/components/schemas/PreparedTransactionSignatureEvent"
                }
            }
        }
    ],
    "components": {
        "schemas": {
            "Null": {
                "title": "Null",
                "type": "null",
                "description": "Represents a null value, used in responses where no data is returned."
            },
            "SubmitDelegatedSignaturesRequest": {
                "title": "SubmitDelegatedSignaturesRequest",
                "type": "object",
                "additionalProperties": false,
                "description": "Signatures collected for one delegated signing request.",
                "properties": {
                    "requestId": {
                        "title": "requestId",
                        "type": "string",
                        "description": "Id of the delegated signing request, as handed to the coordinator in its URL."
                    },
                    "signatures": {
                        "title": "signatures",
                        "type": "array",
                        "description": "Every owner's signature over the request's prepared-transaction hash.",
                        "items": {
                            "$ref": "api-specs/openrpc-dapp-api.json#/components/schemas/SignatureEntry"
                        }
                    }
                },
                "required": ["requestId", "signatures"]
            },
            "SubmitDelegatedSignaturesResult": {
                "title": "SubmitDelegatedSignaturesResult",
                "type": "object",
                "additionalProperties": true,
                "description": "The ledger's response to the submitted transaction."
            }
        }
    }
}
